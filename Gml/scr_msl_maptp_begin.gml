/// Map_TP — teleport directly into the target tile's room.
/// Map_TP — 直接传送到目标格所在房间。
///
/// Source basis:
/// 源码依据：
/// - Room content is generated by reading the tile data at global.playerGridX/Y (scr_globaltile_get(...));
/// - 房间内容生成都通过 scr_globaltile_get(...) 读取 global.playerGridX/Y 对应的格数据；
/// - The room asset is chosen by scr_globaltile_get("room_type", gx, gy);
/// - 房间资产由 scr_globaltile_get("room_type", gx, gy) 决定；
/// - o_player reads localX/localY as the landing point when it is created.
/// - o_player 创建时读取 localX/localY 作为落点。
/// So setting grid + room + landing together is self-consistent, avoiding the tile/room mismatch
/// that causes sprite glitches when editing saves offline.
/// 因此同时设置「格 + 房间 + 落点」即可自洽，不会出现离线改存档时房间/格不一致导致的贴图错乱。
///
/// _corner: 0 = top-left / 1 = top-right / 2 = bottom-left / 3 = bottom-right.
/// _corner: 0 左上 / 1 右上 / 2 左下 / 3 右下。
function scr_msl_maptp_begin(_gxIn, _gyIn, _cornerIn)
{
    var _gx = argument0;
    var _gy = argument1;
    var _corner = argument2;

    menuOpen = false;

    // Must be standing on the world map.
    // 必须处于世界地图中。
    if (global.playerGridX == -4 || global.playerGridY == -4)
    {
        notice = "当前不在世界地图 / not on world map";
        noticeTimer = 120;
        return;
    }

    // Already at the target tile: nothing to do.
    // 已在该目标格：无需传送。
    if (global.playerGridX == _gx && global.playerGridY == _gy)
    {
        notice = "已经在这一格 / already here";
        noticeTimer = 120;
        return;
    }

    if (!scr_msl_maptp_can_enter(_gx, _gy))
    {
        notice = "该格无法传送 / blocked";
        noticeTimer = 120;
        return;
    }

    targetGridX = _gx;
    targetGridY = _gy;
    // Resolve the target room from the tile's room_type asset.
    // 由目标格的 room_type 资产解析出目标房间。
    targetRoom = __asset_get_index(scr_globaltile_get("room_type", _gx, _gy, ""));

    if (targetRoom <= 0)
    {
        notice = "目标房间无效 / bad room";
        noticeTimer = 120;
        return;
    }

    var _top = (_corner == 0 || _corner == 1);
    var _left = (_corner == 0 || _corner == 2);

    // Landing at the room edge; if blocked by wall/water, Step nudges to the nearest free tile after the room loads.
    // 落点取房间边缘；若被墙/水挡住，Step 会在房间加载后挪到最近空地块。
    targetLocalX = _left ? 26 : 2288;
    targetLocalY = _top ? 26 : 2288;

    // Clear any position_tag that could override the landing (e.g. caravan / story spawns).
    // 清掉可能覆盖落点的 position_tag（例如商队/剧情出生点）。
    global.position_tag = "NA";

    // Set the world grid + landing, then let the game rebuild the room from the new tile.
    // 设置世界格与落点，随后让游戏按新格重新生成房间。
    global.playerGridX = _gx;
    global.playerGridY = _gy;
    scr_atr_set_simple("localX", targetLocalX);
    scr_atr_set_simple("localY", targetLocalY);
    scr_selfcell_swap(0);

    // Enter the "waiting for room load" phase; the landing correction is done by Step.
    // 进入“等待房间加载”阶段；落点修正由 Step 完成。
    phase = 4;
    phaseTimer = 0;

    var _fb = file_text_open_append("maptp_diag.txt");
    file_text_write_string(_fb, "begin: gx=" + string(_gx) + " gy=" + string(_gy) + " corner=" + string(_corner) + " targetRoom=" + string(targetRoom) + " current=" + string(room) + " local=" + string(targetLocalX) + "," + string(targetLocalY) + "\n");
    file_text_close(_fb);

    // Same room → restart it; otherwise switch to the target room.
    // 同一房间则重启；否则切换到目标房间。
    if (targetRoom == room)
    {
        room_restart();
    }
    else
    {
        scr_smoothRoomChange(targetRoom, [4]);
    }
}
